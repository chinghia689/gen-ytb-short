# Sao chép các giá trị bí mật vào file .env (không commit file này).
# Backend tự đọc các biến cấu hình trong file này.

APP_TIMEZONE=Asia/Ho_Chi_Minh

# Giai đoạn 1: RSS không cần API key. Đưa URL nguồn và trust_score vào config/sources.json.
NEWS_INGESTION_MODE=rss

# Wikimedia khuyến nghị User-Agent có thông tin liên hệ; nhập email hoặc URL liên hệ.
WIKIMEDIA_CONTACT=

# Qwen3 chạy local qua Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3:8b

# OAuth 2.0: bật YouTube Data API v3 và tạo OAuth Client ID loại Desktop app.
# Desktop flow mặc định dùng callback localhost động; không cần đăng ký redirect URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Chỉ đặt web nếu đang dùng OAuth Client loại Web application.
YOUTUBE_OAUTH_FLOW=desktop
# Chỉ dùng với YOUTUBE_OAUTH_FLOW=web.
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/oauth/callback
# Không bắt buộc; token được lưu cục bộ sau khi OAuth hoàn tất.
YOUTUBE_REFRESH_TOKEN=
